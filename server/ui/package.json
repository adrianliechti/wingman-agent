{
	"name": "ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"test:unit": "node --test test/*.test.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"preview": "vite preview",
		"test:e2e": "npm run test:cli && npm run test:web",
		"test:cli": "go test -tags=e2e -run TestTUIE2E -count=1 -v ../../pkg/tui/code",
		"test:web": "go test -tags=e2e -run TestWebUIE2E -count=1 -v .."
	},
	"dependencies": {
		"@floating-ui/react": "^0.27.20",
		"@microsoft/agent-host-protocol": "1.1.0",
		"@monaco-editor/react": "^4.7.0",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/highlight": "^1.2.12",
		"@tanstack/markdown": "^1.2.1",
		"@tanstack/react-query": "^5.108.4",
		"@tanstack/react-table": "^9.3.1",
		"@tanstack/react-virtual": "^3.14.28",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"devicon": "^2.18.0",
		"lucide-react": "^1.78.0",
		"mermaid": "^12.3.0",
		"monaco-editor": "^0.58.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.24.1",
		"simple-icons": "^16.38.1",
		"smol-toml": "^1.9.1",
		"tailwindcss": "^4.3.5",
		"vscode-languageserver-types": "^3.18.6",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@microsoft/agent-host-protocol-v1": "npm:@microsoft/agent-host-protocol@1.0.0",
		"@playwright/test": "~1.65.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"oxc-transform-react": "^0.156.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8"
	}
}
