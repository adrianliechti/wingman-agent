{
	"name": "ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint",
		"test:unit": "node --test test/*.test.ts",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"preview": "vite preview",
		"test:e2e": "npm run test:cli && npm run test:web",
		"test:cli": "go test -tags=e2e -run TestTUIE2E -count=1 -v ../../pkg/tui/code",
		"test:web": "go test -tags=e2e -run TestWebUIE2E -count=1 -v .."
	},
	"dependencies": {
		"@floating-ui/react": "^0.27.20",
		"@monaco-editor/react": "^4.7.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/markdown": "^0.0.15",
		"@tanstack/react-query": "^5.104.0",
		"@tanstack/react-table": "^9.2.4",
		"@tanstack/react-virtual": "^3.14.13",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"devicon": "^2.17.0",
		"lucide-react": "^1.48.0",
		"mermaid": "^11.17.2",
		"monaco-editor": "^0.57.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-resizable-panels": "^4.14.1",
		"simple-icons": "^16.33.0",
		"smol-toml": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"vscode-languageserver-types": "^3.18.4",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@babel/core": "^7.29.7",
		"@playwright/test": "~1.62.1",
		"@rolldown/plugin-babel": "^0.2.4",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.1"
	}
}
